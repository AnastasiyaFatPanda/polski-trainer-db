# Same Atlas cluster the API uses.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/polski_trainer?retryWrites=true&w=majority

# Path to the polski_trainer frontend repo's data/ folder (source of the initial import).
# Example: /Users/anastasiyakakura/Documents/GitHub/polski_trainer/data
FRONTEND_DATA_DIR=../polski_trainer/data

# Where export-backup.ts writes its JSON dumps.
BACKUP_DIR=./backups
